"use strict";
let secretNumber = Math.floor(Math.random() * 100) + 1;
let attempts = 0;
const form = document.getElementById("guess-form");
const input = document.getElementById("guess");
const feedback = document.getElementById("feedback");
const attemptsDisplay = document.getElementById("attempts");
const resetButton = document.getElementById("reset-button");
form.addEventListener("submit", function (event) {

    event.preventDefault();
    attempts++;

    attemptsDisplay.textContent = attempts;
    const value = input.value.trim();
    const guess = Number(value);
    if (
        value === "" ||
        !Number.isInteger(guess) ||
        guess < 1 ||
        guess > 100
    ) {
        feedback.textContent =
            "Ce n'est pas valide. Entrez un nombre entier entre 1 et 100.";

        input.value = "";
        input.focus();

        return;
    }
    if (guess < secretNumber) {

        feedback.textContent = "C'est plus grand !";

    } else if (guess > secretNumber) {

        feedback.textContent = "C'est plus petit !";

    } else {
        feedback.textContent =
            "Bravo ! Vous avez trouvé le nombre secret : " +
            secretNumber +
            ". Score : " +
            attempts +
            " essais.";
        input.disabled = true;
        form.querySelector("button").disabled = true;
    }

});
resetButton.addEventListener("click", function () {

    secretNumber = Math.floor(Math.random() * 100) + 1;

    attempts = 0;

    attemptsDisplay.textContent = attempts;

    feedback.textContent = "Nouvelle partie ! Bonne chance.";

    input.value = "";
    input.disabled = false;

    form.querySelector("button").disabled = false;

    input.focus();

});
